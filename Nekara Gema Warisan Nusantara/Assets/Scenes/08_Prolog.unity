--- !u!114 &1633867653
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1633867652}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6c186f9ed23514b4a8ecb8659ffe7853, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueManager
  textNamaKiri: {fileID: 1376629206}
  textNamaKanan: {fileID: 1833073264}
  textIsiDialog: {fileID: 267968055}
  imageKiri: {fileID: 1897271793}
  imageKanan: {fileID: 758515413}
  fxKiri: {fileID: 1897271795}
  fxKanan: {fileID: 758515416}
  fokusUI: {fileID: 621646794}
  daftarPercakapan:
  - siapaYangNgobrol: 1
    namaKarakter: Ujang
    isiDialog: '"Kek, kabut itu muncul lagi?"'
    spriteKiri: {fileID: 1042042900, guid: 75df208a9738b074581b5a58187cc78a, type: 3}
    spriteKanan: {fileID: 659756483, guid: 75df208a9738b074581b5a58187cc78a, type: 3}
  - siapaYangNgobrol: 0
    namaKarakter: Aki Rana
    isiDialog: '"Iya, Ujang. kali ini kabut itu semakin sulit dikendalikan. Dia telah
      menjelma jadi entitas"'
    spriteKiri: {fileID: 1042042900, guid: 75df208a9738b074581b5a58187cc78a, type: 3}
    spriteKanan: {fileID: 659756483, guid: 75df208a9738b074581b5a58187cc78a, type: 3}
  - siapaYangNgobrol: 1
    namaKarakter: 'Ujang '
    isiDialog: "\"Siapa dia? kenapa dia datang, Ki?\u201D"
    spriteKiri: {fileID: 1042042900, guid: 75df208a9738b074581b5a58187cc78a, type: 3}
    spriteKanan: {fileID: 659756483, guid: 75df208a9738b074581b5a58187cc78a, type: 3}
  - siapaYangNgobrol: 0
    namaKarakter: Aki Rana
    isiDialog: '"Dia adalah Kabut Memori dia tidak muncul begitu saja, Jang."'
    spriteKiri: {fileID: 1042042900, guid: 75df208a9738b074581b5a58187cc78a, type: 3}
    spriteKanan: {fileID: 659756483, guid: 75df208a9738b074581b5a58187cc78a, type: 3}
  - siapaYangNgobrol: 0
    namaKarakter: Aki Rana
    isiDialog: '"Kabut ini tumbuh dari ingatan yang hilang. Semakin banyak orang
      melupakan kebudayaan Nusantara, semakin kuat kabut itu. Hingga akhirnya, ia
      menjadi entitas tersendiri."

'
    spriteKiri: {fileID: 1042042900, guid: 75df208a9738b074581b5a58187cc78a, type: 3}
    spriteKanan: {fileID: 659756483, guid: 75df208a9738b074581b5a58187cc78a, type: 3}
  - siapaYangNgobrol: 1
    namaKarakter: Ujang
    isiDialog: '"Lalu bagaimana nasib festival budaya kita kek? sepuluh hari dari
      sekarang festival harus dilaksanakan, tetapi semua alatmusik dimuseum hilang
      akibat kabut memori!"'
    spriteKiri: {fileID: 1042042900, guid: 75df208a9738b074581b5a58187cc78a, type: 3}
    spriteKanan: {fileID: 659756483, guid: 75df208a9738b074581b5a58187cc78a, type: 3}
  - siapaYangNgobrol: 0
    namaKarakter: Aki Rana
    isiDialog: '" Betul Jang, Aki titipkan festival museum kita kepadamu."'
    spriteKiri: {fileID: 1042042900, guid: 75df208a9738b074581b5a58187cc78a, type: 3}
    spriteKanan: {fileID: 659756483, guid: 75df208a9738b074581b5a58187cc78a, type: 3}
  - siapaYangNgobrol: 0
    namaKarakter: Aki Rana
    isiDialog: '"Menjelajah lah kamu, pergi ke daerah asal alat-alat musik. Kita
      harus mengembalikan apa yang mulai dilupakan, Jang. '
    spriteKiri: {fileID: 1042042900, guid: 75df208a9738b074581b5a58187cc78a, type: 3}
    spriteKanan: {fileID: 659756483, guid: 75df208a9738b074581b5a58187cc78a, type: 3}
  - siapaYangNgobrol: 0
    namaKarakter: Aki Rana
